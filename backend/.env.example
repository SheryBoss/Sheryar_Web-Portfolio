# =================================================================
# DEVELOPER'S UNIVERSE - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to '.env' and fill in your confidential credentials.
# Never commit the real '.env' file to Git!

# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Module 4: RAG Chatbot)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Storage Configuration (Module 4)
# Optional ChromaDB Host/Port. If ChromaDB server is not running, the system
# automatically and safely falls back to the embedded in-process vector store.
CHROMA_SERVER_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=sheryar_portfolio_rag

# Nodemailer Email Configuration (Module 5: Contact Form)
# For production: Use Gmail App Password or SMTP provider (SendGrid, Mailgun, Brevo)
# If left empty, contact messages are logged to console and saved in test mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
